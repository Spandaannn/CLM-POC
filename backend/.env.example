# Copy this file to backend/.env and replace CHANGE_ME with your local
# PostgreSQL password. Never commit backend/.env to Git.
#
# This project uses the psycopg 3 driver, so the URL scheme is
# postgresql+psycopg://. A plain postgresql:// URL is also accepted and is
# rewritten to use psycopg.
#
# If your password contains URL-special characters, percent-encode them:
# @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25
DATABASE_URL=postgresql+psycopg://clm_user:CHANGE_ME@localhost:5432/clm_db

# Set to true only when you want SQLAlchemy to log every SQL statement.
DATABASE_ECHO=false

# Session and cookie settings.
# SESSION_TTL_MINUTES: absolute login lifetime in minutes (default 8 hours).
# COOKIE_SECURE: set true when served over HTTPS. Required in production.
# COOKIE_SAMESITE: lax (default), strict, or none. "none" requires Secure=true.
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Where uploaded contract documents are stored on disk. A relative path is
# resolved against backend/. Keep this outside any publicly served directory
# and back it up together with the database. Never commit this directory.
DOCUMENT_STORAGE_PATH=storage/documents

# Leave EMPTY in local development (Vite serves the frontend and proxies /api).
# The Docker image sets this to the built React app so FastAPI serves it from
# the same origin; see DEPLOYMENT.md.
FRONTEND_DIST_DIR=

# --- AI contract review (optional) ---------------------------------------
# The application works without these; the AI Reviews section then shows that
# AI is not configured. Contract text is sent to the provider ONLY when a
# signed-in user clicks "Run AI review". Never commit your real key; it belongs
# only in backend/.env (which is Git-ignored).
#
# Provider name. Currently supported: groq
AI_PROVIDER=groq
# Create a key in the Groq console and paste it here (keep it secret).
GROQ_API_KEY=
# Model used for reviews.
GROQ_MODEL=openai/gpt-oss-20b
# Optional tuning:
# GROQ_REASONING_EFFORT=low    # low|medium|high for gpt-oss models; empty to omit
# AI_MAX_OUTPUT_TOKENS=4000    # cap on the AI's answer length (counts toward rate limits)
# AI_TIMEOUT_SECONDS=90        # per request, 5-300
# AI_MAX_INPUT_CHARS=30000     # max contract characters sent (long files are cut off)
# AI_PLAYBOOK_PATH=           # path to a JSON playbook replacing the built-in baseline
