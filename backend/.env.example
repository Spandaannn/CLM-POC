# Copy this file to backend/.env and replace CHANGE_ME with your local
# PostgreSQL password. Never commit backend/.env to Git.
#
# This project uses the psycopg 3 driver, so the URL scheme is
# postgresql+psycopg://. A plain postgresql:// URL is also accepted and is
# rewritten to use psycopg.
#
# If your password contains URL-special characters, percent-encode them:
# @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25
DATABASE_URL=postgresql+psycopg://clm_user:CHANGE_ME@localhost:5432/clm_db

# Set to true only when you want SQLAlchemy to log every SQL statement.
DATABASE_ECHO=false

# Session and cookie settings.
# SESSION_TTL_MINUTES: absolute login lifetime in minutes (default 8 hours).
# COOKIE_SECURE: set true when served over HTTPS. Required in production.
# COOKIE_SAMESITE: lax (default), strict, or none. "none" requires Secure=true.
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Where uploaded contract documents are stored on disk. A relative path is
# resolved against backend/. Keep this outside any publicly served directory
# and back it up together with the database. Never commit this directory.
DOCUMENT_STORAGE_PATH=storage/documents
