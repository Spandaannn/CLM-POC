# Keep secrets, local data and bulky/irrelevant files out of the Docker image.

# Version control
.git
.gitignore

# Secrets and environment files (the example files are not needed either)
**/.env
**/.env.*

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/.venv
**/venv
**/dist
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.tsbuildinfo
**/*.log

# Uploaded or generated documents and local storage
**/storage
**/*.pdf
**/*.docx

# Not needed at run time
backend/tests
backend/requirements-dev.txt
*.md
.vscode
.idea
